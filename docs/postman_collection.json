{
    "info": {
        "name": "QMS Complete Ecosystem API (Secured)",
        "description": "Full API Suite: System, Auth, Catalog (with Admin endpoints), and Secured Order Management",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "System",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/health",
                            "host": ["{{base_url}}"],
                            "path": ["health"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Auth API",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Test User\",\n  \"phone\": \"9998887777\",\n  \"otp\": \"1234\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": ["{{base_url}}"],
                            "path": ["auth", "register"]
                        }
                    }
                },
                {
                    "name": "Login User (Auto-Saves Token)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.access_token) {",
                                    "    pm.collectionVariables.set(\"jwt_token\", jsonData.access_token);",
                                    "    console.log(\"Token automatically saved!\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"9998887777\",\n  \"otp\": \"1234\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["auth", "login"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Catalog API",
            "item": [
                {
                    "name": "Get Catalog (Paginated)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/catalog/?page=1&size=10",
                            "host": ["{{base_url}}"],
                            "path": ["catalog", ""],
                            "query": [
                                {"key": "page", "value": "1"},
                                {"key": "size", "value": "10"}
                            ]
                        }
                    }
                },
                {
                    "name": "Search Catalog",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/catalog/search?q=apple",
                            "host": ["{{base_url}}"],
                            "path": ["catalog", "search"],
                            "query": [
                                {"key": "q", "value": "apple"}
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single Product",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/catalog/PRODUCT_ID_HERE",
                            "host": ["{{base_url}}"],
                            "path": ["catalog", "PRODUCT_ID_HERE"]
                        }
                    }
                },
                {
                    "name": "Admin: Create Product",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"product_id\": \"ipad-pro-13\",\n  \"name\": \"iPad Pro 13-inch (M4)\",\n  \"category\": \"Electronics\",\n  \"price\": 1299.99,\n  \"stock\": 50,\n  \"vendor\": \"Apple\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/catalog/",
                            "host": ["{{base_url}}"],
                            "path": ["catalog", ""]
                        }
                    }
                },
                {
                    "name": "Admin: Update Stock",
                    "request": {
                        "method": "PATCH",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quantity_to_add\": 25\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/catalog/PRODUCT_ID_HERE/stock",
                            "host": ["{{base_url}}"],
                            "path": ["catalog", "PRODUCT_ID_HERE", "stock"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Orders API (Protected)",
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{jwt_token}}",
                        "type": "string"
                    }
                ]
            },
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"product_id\": \"macbook-pro-16\",\n  \"quantity\": 1\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/orders/",
                            "host": ["{{base_url}}"],
                            "path": ["orders", ""]
                        }
                    }
                },
                {
                    "name": "Get All Orders",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/orders/",
                            "host": ["{{base_url}}"],
                            "path": ["orders", ""]
                        }
                    }
                },
                {
                    "name": "Get Order By ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/orders/ORDER_ID_HERE",
                            "host": ["{{base_url}}"],
                            "path": ["orders", "ORDER_ID_HERE"]
                        }
                    }
                },
                {
                    "name": "Update Order",
                    "request": {
                        "method": "PUT",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"shipped\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/orders/ORDER_ID_HERE",
                            "host": ["{{base_url}}"],
                            "path": ["orders", "ORDER_ID_HERE"]
                        }
                    }
                },
                {
                    "name": "Delete Order",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/orders/ORDER_ID_HERE",
                            "host": ["{{base_url}}"],
                            "path": ["orders", "ORDER_ID_HERE"]
                        }
                    }
                }
            ]
        }
    ]
}