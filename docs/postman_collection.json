{
  "info": {
    "name": "Order Management API",
    "description": "CRUD endpoints for the generic order management service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "REPLACE_WITH_GENERATED_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": \"macbook-pro-16\",\n  \"customer_id\": \"usr_8923\",\n  \"amount\": 2499.99,\n  \"status\": \"pending\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            ""
          ]
        }
      }
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            ""
          ]
        }
      }
    },
    {
      "name": "Get Single Order",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      }
    },
    {
      "name": "Update Order",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"shipped\",\n  \"tracking_number\": \"TRK-992384\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      }
    },
    {
      "name": "Delete Order",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      }
    }
  ]
}